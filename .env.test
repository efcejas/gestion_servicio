# Configuración para tests locales
# Este archivo se usa automáticamente durante los tests
# NO afecta la configuración de producción en Heroku

SECRET_KEY=test-secret-key-for-testing-only-do-not-use-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos LOCAL para tests (SQLite)
DATABASE_URL=sqlite:///test_db.sqlite3

# Email (no se usa en tests, pero es requerido)
GMAIL_USER=test@example.com
GMAIL_PASSWORD=test-password
