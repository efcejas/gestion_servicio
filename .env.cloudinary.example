# ==============================================================================
# CLOUDINARY CONFIGURATION (para app clases_residentes)
# ==============================================================================
# Para obtener estas credenciales:
# 1. Crear cuenta gratuita en https://cloudinary.com/
# 2. Ir al Dashboard
# 3. Copiar los valores de Cloud Name, API Key y API Secret
# 4. Agregar las siguientes variables a tu archivo .env:

CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ==============================================================================
# NOTA: Si no configuras Cloudinary, el sistema usará almacenamiento local
# por defecto (carpeta media/). Las clases funcionarán igualmente.
# ==============================================================================
