{% extends "layouts/base_tailwind.html" %}

{% block title %}Iniciar Sesión - Dr. Cejas{% endblock %}

{% block content %}
<div class="min-h-screen flex items-center justify-center py-4 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div>
            <div class="mx-auto h-20 w-20 flex items-center justify-center rounded-2xl bg-gradient-to-br from-medical-primary to-medical-secondary shadow-xl transform hover:scale-105 transition-all duration-300">
                <i class="fas fa-heartbeat text-white text-3xl drop-shadow-lg"></i>
            </div>
            <h2 class="mt-4 text-center text-4xl font-bold bg-gradient-to-r from-medical-primary to-medical-secondary bg-clip-text text-transparent">
                Bienvenido
            </h2>
        </div>

        <div class="bg-white py-10 px-8 shadow-2xl rounded-2xl border border-gray-100 backdrop-blur-sm">
            {% if form.errors or messages %}
            <div class="mb-6">
                {% if form.errors %}
                    {% if form.non_field_errors %}
                        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md flex items-center">
                            <i class="fas fa-exclamation-circle text-red-400 mr-3"></i>
                            <span><strong>Error:</strong> Nombre de usuario o contraseña incorrectos.</span>
                        </div>
                    {% else %}
                        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md flex items-center">
                            <i class="fas fa-exclamation-circle text-red-400 mr-3"></i>
                            <span><strong>Error:</strong> Por favor, ingrese su nombre de usuario y contraseña.</span>
                        </div>
                    {% endif %}
                {% endif %}
                
                {# messages will be shown via global toast in base template #}
            </div>
            {% endif %}

            <form method="post" class="space-y-6">
                {% csrf_token %}
                
                <div>
                    <label for="username" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-user mr-2 text-gray-400"></i>Nombre de usuario
                    </label>
                    <input type="text" 
                           name="username" 
                           id="username" 
                           required
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl shadow-sm placeholder-gray-400 focus:outline-none focus:ring-3 focus:ring-medical-primary/30 focus:border-medical-primary transition-all duration-300 hover:border-medical-primary/50"
                           placeholder="Ingresa tu nombre de usuario">
                </div>

                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-lock mr-2 text-gray-400"></i>Contraseña
                    </label>
                    <input type="password" 
                           name="password" 
                           id="password" 
                           required
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl shadow-sm placeholder-gray-400 focus:outline-none focus:ring-3 focus:ring-medical-primary/30 focus:border-medical-primary transition-all duration-300 hover:border-medical-primary/50"
                           placeholder="Ingresa tu contraseña">
                </div>

                <div>
                    <button type="submit" 
                            class="group relative w-full flex justify-center py-4 px-6 border border-transparent text-base font-semibold rounded-xl text-white bg-gradient-to-r from-medical-primary to-medical-secondary hover:from-medical-primary/90 hover:to-medical-secondary/90 focus:outline-none focus:ring-4 focus:ring-medical-primary/30 transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl">
                        <span class="absolute left-0 inset-y-0 flex items-center pl-4">
                            <i class="fas fa-sign-in text-white/80 group-hover:text-white group-hover:scale-110 transition-all duration-200"></i>
                        </span>
                        Iniciar Sesión
                    </button>
                </div>
            </form>

            <div class="mt-6">
                <div class="relative">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-gray-300"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-2 bg-white text-gray-500">¿Necesitas ayuda?</span>
                    </div>
                </div>

                <div class="mt-6 space-y-3">
                    <div class="text-center">
                        <a href="{% url 'password_reset' %}" 
                           class="text-blue-600 hover:text-blue-800 text-sm font-medium transition-colors duration-200 flex items-center justify-center">
                            <i class="fas fa-key mr-2"></i>¿Olvidaste tu contraseña?
                        </a>
                    </div>
                    <div class="text-center">
                        <span class="text-gray-600 text-sm">¿No tienes una cuenta? </span>
                        <a href="{% url 'accounts:register' %}" 
                           class="text-blue-600 hover:text-blue-800 text-sm font-medium transition-colors duration-200">
                            <i class="fas fa-user-plus mr-1"></i>Regístrate aquí
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center">
            <p class="text-xs text-gray-500">
                © 2025 Dr. Enso Fermín Cejas. Sistema de Gestión Médica.
            </p>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
    // Auto-focus en el campo de username
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('username').focus();
    });
</script>
{% endblock %}