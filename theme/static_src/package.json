{
  "name": "theme",
  "version": "1.0.0",
  "description": "Tailwind CSS theme for Django project",
  "main": "index.js",
  "scripts": {
    "dev": "npm run tailwind-watch",
    "tailwind-watch": "tailwindcss -i ./src/styles.css -o ../static/css/tailwind.css --watch",
    "build": "tailwindcss -i ./src/styles.css -o ../static/css/tailwind.css --watch",
    "build-prod": "tailwindcss -i ./src/styles.css -o ../static/css/tailwind.css"
  },
  "keywords": [
    "tailwind",
    "css",
    "django"
  ],
  "author": "Tu Nombre",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "flowbite": "^3.1.2"
  }
}
